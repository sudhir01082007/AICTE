{
  "name": "aicte-approval-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Integrated AICTE Approval Workflow Automation, Compliance Monitoring and Alert Management System",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev:server": "npm --prefix server run start:dev",
    "dev:client": "npm --prefix client run dev",
    "build:server": "npm --prefix server run build",
    "build:client": "npm --prefix client run build",
    "build": "npm run build:server && npm run build:client",
    "prisma:generate": "npm --prefix server run prisma:generate",
    "prisma:migrate": "npm --prefix server run prisma:migrate",
    "prisma:seed": "npm --prefix server run prisma:seed"
  },
  "keywords": [
    "aicte",
    "workflow-automation",
    "compliance",
    "audit-trail"
  ],
  "author": "AICTE Platform Engineering Team",
  "license": "UNLICENSED"
}
